}
attack={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":74), Object(InputEventKey,"device":-1,"physical_keycode":88), Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}
