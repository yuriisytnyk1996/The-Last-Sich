; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Last Sich"
config/version="0.0.24"
run/main_scene="res://ui/menus/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
DisplaySettings="*res://autoload/display_settings.gd"
HitStop="*res://autoload/hit_stop.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioSettings="*res://autoload/audio_settings.gd"
AccessibilitySettings="*res://autoload/accessibility_settings.gd"
Rumble="*res://autoload/rumble.gd"
InputSettings="*res://autoload/input_settings.gd"
Pool="*res://autoload/pool.gd"
LanguageSettings="*res://autoload/language_settings.gd"
DebugConsole="*res://autoload/debug_console.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/text_extractor/plugin.cfg")

