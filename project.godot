"events": [Object(InputEventKey,"device":-1,"physical_keycode":75), Object(InputEventKey,"device":-1,"physical_keycode":67), Object(InputEventKey,"device":-1,"physical_keycode":4194325), Object(InputEventJoypadButton,"device":-1,"button_index":10)]
