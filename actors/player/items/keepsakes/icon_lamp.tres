[ext_resource type="Script" path="res://actors/player/items/effects/unlock_effect.gd" id="unlock"]
[ext_resource type="Script" path="res://actors/player/items/effects/item_effect.gd" id="effect"]

[sub_resource type="Resource" id="effect_1"]
