[resource]
script = ExtResource("item")
id = &"icon_lamp"
title = "Icon lamp"
description = "A small lamp that once burned before a church icon. Rest points fill your spirit, and you rise from death with it full."
kind = 2
price = 500
effects = Array[ExtResource("effect")]([SubResource("effect_1")])
