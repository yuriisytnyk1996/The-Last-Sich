[resource]
script = ExtResource("item")
id = &"sich_letter_3"
title = "Sich letter (3 of 3)"
description = "A letter folded small and sewn into cloth. It warns of riders crossing the steppe. The elder in the test room collects them."
lore = "Riders carried the Sich's letters across the steppe, and when a rider fell, the letter lay where he fell. Whoever brings one home is owed a cup and a place at the fire."
kind = 5
price = 0
