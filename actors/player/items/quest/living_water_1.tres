[resource]
script = ExtResource("item")
id = &"living_water_1"
title = "Living water of the rapids"
description = "A vial of living water drawn below the Dnipro rapids. A flask healer can mix it into your flasks."
lore = "Drawn where the river breaks on the stones and no boat lands twice. The old men said the water there remembers every Cossack who crossed it."
kind = 5
price = 0
