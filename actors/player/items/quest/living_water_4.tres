script = ExtResource("item")
id = &"living_water_4"
title = "Living water of the spring"
description = "A vial of living water from a spring under an oak. A flask healer can mix it into your flasks."
lore = "The oak was older than the Sich. Pilgrims left ribbons on its branches, and the spring under its roots never froze."
