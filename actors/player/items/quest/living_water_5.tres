script = ExtResource("item")
id = &"living_water_5"
title = "Living water of the steppe"
description = "A vial of living water from rain caught on the open steppe. A flask healer can mix it into your flasks."
lore = "Caught in a helmet during the only storm of a dry summer. The rider who caught it shared it with his horse first."
