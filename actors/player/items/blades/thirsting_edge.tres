[gd_resource type="Resource" script_class="Item" format=3]

[ext_resource type="Script" path="res://actors/player/items/item.gd" id="item"]
[ext_resource type="Script" path="res://actors/player/items/effects/stat_effect.gd" id="stat"]
[ext_resource type="Script" path="res://actors/player/items/effects/restore_effect.gd" id="restore"]
[ext_resource type="Script" path="res://components/stats/stat_modifier.gd" id="mod"]
[ext_resource type="Script" path="res://actors/player/items/effects/item_effect.gd" id="effect"]

[sub_resource type="Resource" id="mod_1"]
script = ExtResource("mod")
stat = &"damage"
kind = 1
value = -0.1

[sub_resource type="Resource" id="effect_2"]
script = ExtResource("stat")
trigger = 1
modifiers = Array[ExtResource("mod")]([SubResource("mod_1")])

[sub_resource type="Resource" id="effect_3"]
script = ExtResource("restore")
trigger = 2
chance = 0.3
what = 0
amount = 3

[resource]
script = ExtResource("item")
id = &"thirsting_edge"
title = "Thirsting edge"
description = "A blade that drinks. Hits have a 30% chance to heal 3, but damage -10%."
kind = 1
price = 600
effects = Array[ExtResource("effect")]([SubResource("effect_2"), SubResource("effect_3")])
