title = "Duma of the Sworn Brother"
description = "Sing it for 25 spirit: a sworn brother's ghost fights at the singer's side for 30 seconds, cutting when they cut and shielding them when they guard."
lore = "Two Cossacks who swap crosses become brothers until death, and some say past it. The song calls the one who went first, and he comes back to stand at the other's shoulder."
