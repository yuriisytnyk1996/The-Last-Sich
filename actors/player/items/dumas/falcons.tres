[resource]
script = ExtResource("item")
id = &"falcons"
title = "Duma of the Falcons"
description = "Sing it for 20 spirit: three falcons circle the singer for 20 seconds. Each one stoops on the nearest enemy in sight and strikes once."
lore = "A captive on a galley sang to the falcons over the sea and asked them to fly home with word of him. The song is sung now to send them the other way, at the singer's enemies."
kind = 4
price = 800
effects = Array[ExtResource("effect")]([SubResource("effect_1")])
spirit_cost = 20.0
