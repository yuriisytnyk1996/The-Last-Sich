[resource]
script = ExtResource("item")
id = &"three_brothers"
title = "Duma of the Three Brothers"
description = "Sing it for 10 spirit: three shots fly forward, one after another."
lore = "Three brothers fled Azov on foot, and only the youngest came home. The duma gives each of them one shot, and the listeners never agree on which one missed."
