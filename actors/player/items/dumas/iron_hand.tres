[gd_resource type="Resource" script_class="Item" format=3]

[ext_resource type="Script" path="res://actors/player/items/item.gd" id="item"]
[ext_resource type="Script" path="res://actors/player/items/effects/item_effect.gd" id="effect"]
[ext_resource type="Script" path="res://actors/player/items/effects/heavy_strikes_effect.gd" id="heavy"]
[ext_resource type="Script" path="res://actors/player/items/effects/stat_effect.gd" id="stat"]
[ext_resource type="Script" path="res://components/stats/stat_modifier.gd" id="mod"]

[sub_resource type="Resource" id="mod_1"]
script = ExtResource("mod")
stat = &"damage"
kind = 1
value = 0.25

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("heavy")
trigger = 5
duration = 20.0

[sub_resource type="Resource" id="effect_2"]
script = ExtResource("stat")
trigger = 5
duration = 20.0
modifiers = Array[ExtResource("mod")]([SubResource("mod_1")])

[resource]
script = ExtResource("item")
id = &"iron_hand"
title = "Duma of the Iron Hand"
description = "Sing it for 20 spirit: for 20 seconds every swing hits heavy and deals 25% more damage."
lore = "Sung before a charge, fist on the saddle. The hand that strikes after it is said to weigh as much as the horse beneath it."
kind = 4
price = 800
effects = Array[ExtResource("effect")]([SubResource("effect_1"), SubResource("effect_2")])
spirit_cost = 20.0
