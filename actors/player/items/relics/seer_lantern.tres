[gd_resource type="Resource" script_class="Item" format=3]

[ext_resource type="Script" path="res://actors/player/items/item.gd" id="item"]
[ext_resource type="Script" path="res://actors/player/items/effects/unlock_effect.gd" id="unlock"]
[ext_resource type="Script" path="res://actors/player/items/effects/item_effect.gd" id="effect"]

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("unlock")
trigger = 1
unlock = "reveal_platforms"

[resource]
script = ExtResource("item")
id = &"seer_lantern"
title = "Seer's lantern"
description = "Its pale light shows platforms no one else can see while it is worn."
kind = 3
price = 1000
effects = Array[ExtResource("effect")]([SubResource("effect_1")])
