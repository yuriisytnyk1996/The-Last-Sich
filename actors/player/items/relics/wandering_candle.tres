[resource]
script = ExtResource("item")
id = &"wandering_candle"
title = "Wandering candle"
description = "Its flame leaves the wick while it is worn and drifts after the wearer, stopping over anyone still held captive in the room."
lore = "Candles lit for the lost are said to look for them. This one was lit for a son taken by raiders and never put out; its flame still wanders off to every cage it finds."
kind = 3
price = 600
effects = Array[ExtResource("effect")]([SubResource("effect_1")])
