[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://components/story/dialogue.gd" id="r1"]
[ext_resource type="Script" path="res://components/story/story_outcome.gd" id="r2"]
[ext_resource type="Script" path="res://components/story/story_condition.gd" id="r3"]

[sub_resource type="Resource" id="outcome_1"]
script = ExtResource("r2")
reward = 150
set_flags = Array[StringName]([&"elder_captives_1"])

[sub_resource type="Resource" id="condition_2"]
script = ExtResource("r3")
count_prefix = "freed_captive_"
count_at_least = 1
no_flags = Array[StringName]([&"elder_captives_1"])

[resource]
script = ExtResource("r1")
lines = PackedStringArray("One of our captives walked in this morning, thin as a reed, and said a Cossack broke his cage.", "There are two more. Here, for your trouble.")
outcome = SubResource("outcome_1")
condition = SubResource("condition_2")
