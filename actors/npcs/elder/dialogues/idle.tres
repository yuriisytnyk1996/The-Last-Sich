[resource]
script = ExtResource("r1")
lines = PackedStringArray("Three of ours sit in cages: one in the cave, one in the crypt, one in the barracks. Break the bars.", "Three letters lie where their riders fell: in the hideout, the barracks and the works.", "And if your purse is heavy, the church in the crypt keeps an alms box.")
