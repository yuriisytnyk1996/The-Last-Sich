[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://components/story/dialogue.gd" id="r1"]
[ext_resource type="Script" path="res://components/story/story_outcome.gd" id="r2"]
[ext_resource type="Resource" path="res://actors/player/items/blades/guarding_edge.tres" id="r3"]
[ext_resource type="Script" path="res://actors/player/items/item.gd" id="r4"]
[ext_resource type="Script" path="res://components/story/story_condition.gd" id="r5"]

[sub_resource type="Resource" id="outcome_1"]
script = ExtResource("r2")
give_items = Array[ExtResource("r4")]([ExtResource("r3")])
set_flags = Array[StringName]([&"elder_letters_done"])

[sub_resource type="Resource" id="condition_2"]
script = ExtResource("r5")
counter = &"letters_delivered"
counter_at_least = 3
no_flags = Array[StringName]([&"elder_letters_done"])

[resource]
script = ExtResource("r1")
lines = PackedStringArray("Every letter is home. The Kosh will know where the boats are, and the powder, and the riders.", "This edge was a scout's. It turned many blows; let it turn yours.")
outcome = SubResource("outcome_1")
condition = SubResource("condition_2")
