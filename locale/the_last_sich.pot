#. TRANSLATORS: speaker
#: levels/objects/story/alms/blessing_1.tres
#: levels/objects/story/alms/blessing_2.tres
msgid "A voice behind the wall"
msgstr ""

#. TRANSLATORS: lines
#: levels/objects/story/alms/blessing_1.tres
msgid "Someone feeds the box. Bless you, Cossack. Here, our old bell: ring it and the dead remember they are dead."
msgstr ""

#. TRANSLATORS: lines
#: levels/objects/story/alms/blessing_2.tres
msgid "So much, for a church of rats and candle ends? Then take this knot. The sisters tied it for the sick, and you will need it more than they do."
msgstr ""

#. TRANSLATORS: lines
#: levels/objects/story/alms/box.tres
msgid "An iron box for the church, chained to the wall. Coins rattle somewhere deep inside."
msgstr ""

#. TRANSLATORS: text
#: levels/objects/story/alms/box.tres
msgid "Give 200"
msgstr ""

#. TRANSLATORS: message
#: levels/objects/story/alms/box.tres
msgid "Given to the church: 200"
msgstr ""

#. TRANSLATORS: text
#: levels/objects/story/alms/box.tres
msgid "Give 500"
msgstr ""

#. TRANSLATORS: message
#: levels/objects/story/alms/box.tres
msgid "Given to the church: 500"
msgstr ""

#. TRANSLATORS: text
#: levels/objects/story/alms/box.tres
#: ui/menus/shop/buy_screen.gd:29
#: ui/menus/shop/cleanse_screen.gd:27
#: ui/menus/shop/cleanse_screen.gd:32
#: ui/menus/shop/flask_healer_screen.gd:25
