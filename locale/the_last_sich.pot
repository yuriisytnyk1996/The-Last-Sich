#. TRANSLATORS: title
#: actors/player/items/keepsakes/chumak_whip.tres
msgid "Chumak's whip"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/keepsakes/chumak_whip.tres
msgid "A salt trader's whip, worn smooth by a thousand roads. Kneel at a rest point to travel to any other you have found."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/keepsakes/chumak_whip.tres
msgid "Chumaks drove their ox carts to the salt lakes and back, a road of months. The whip knows every way home, even the ones no map shows."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/keepsakes/icon_lamp.tres
msgid "Icon lamp"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/keepsakes/icon_lamp.tres
msgid "A small lamp that once burned before a church icon. Rest points fill your spirit, and you rise from death with it full."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/keepsakes/icon_lamp.tres
msgid "It burned before an icon of the Protectress through two sieges. The church fell; the flame did not. Rest beside it and something is given back."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/keepsakes/leather_pouch.tres
msgid "Leather pouch"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/keepsakes/leather_pouch.tres
#: actors/player/items/keepsakes/stitched_pouch.tres
msgid "Room for one more charm. Charm slots +1."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/keepsakes/leather_pouch.tres
msgid "Cut from an old saddle. It still smells of the horse, who is remembered more fondly than the rider."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/keepsakes/spare_gourd.tres
msgid "Spare gourd"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/keepsakes/spare_gourd.tres
msgid "One more flask to fill at every rest. Flasks +1."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/keepsakes/spare_gourd.tres
msgid "Hollowed and dried by a grandmother who sent it with every grandson who rode south. Most of the gourds came back."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/keepsakes/stitched_pouch.tres
msgid "Stitched pouch"
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/keepsakes/stitched_pouch.tres
msgid "Patched so many times that none of the first leather is left. Its owner swore it was still the same pouch."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/quest/kobza_string.tres
msgid "Kobza string"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/quest/kobza_string.tres
msgid "A coil of waxed gut string. The old kobzar in the cave lost it."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/quest/kobza_string.tres
msgid "Gut from a ram, twisted wet and dried in the shade, then waxed. A kobzar's strings are his bread: without them his songs are only words."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/quest/living_water_1.tres
msgid "Living water of the rapids"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/quest/living_water_1.tres
msgid "A vial of living water drawn below the Dnipro rapids. A flask healer can mix it into your flasks."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/quest/living_water_1.tres
msgid "Drawn where the river breaks on the stones and no boat lands twice. The old men said the water there remembers every Cossack who crossed it."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/quest/living_water_2.tres
msgid "Living water of the well"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/quest/living_water_2.tres
msgid "A vial of living water from a well in a burned village. A flask healer can mix it into your flasks."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/quest/living_water_2.tres
msgid "The village burned, but nobody would touch the well. Its water stayed cold through the whole fire."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/quest/living_water_3.tres
msgid "Living water of the dew"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/quest/living_water_3.tres
msgid "A vial of living water gathered as dew on the night of Kupala. A flask healer can mix it into your flasks."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/quest/living_water_3.tres
msgid "Gathered barefoot before sunrise, from grass no one had walked on. Girls washed their faces in it; this vial was kept for wounds instead."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/quest/living_water_4.tres
msgid "Living water of the spring"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/quest/living_water_4.tres
msgid "A vial of living water from a spring under an oak. A flask healer can mix it into your flasks."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/quest/living_water_4.tres
msgid "The oak was older than the Sich. Pilgrims left ribbons on its branches, and the spring under its roots never froze."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/quest/living_water_5.tres
msgid "Living water of the steppe"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/quest/living_water_5.tres
msgid "A vial of living water from rain caught on the open steppe. A flask healer can mix it into your flasks."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/quest/living_water_5.tres
msgid "Caught in a helmet during the only storm of a dry summer. The rider who caught it shared it with his horse first."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/quest/sich_letter_1.tres
msgid "Sich letter (1 of 3)"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/quest/sich_letter_1.tres
msgid "A letter sealed with the Kosh seal. It names the boats ready below the rapids. The elder in the test room collects them."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/quest/sich_letter_1.tres
#: actors/player/items/quest/sich_letter_2.tres
#: actors/player/items/quest/sich_letter_3.tres
msgid "Riders carried the Sich's letters across the steppe, and when a rider fell, the letter lay where he fell. Whoever brings one home is owed a cup and a place at the fire."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/quest/sich_letter_2.tres
msgid "Sich letter (2 of 3)"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/quest/sich_letter_2.tres
msgid "A letter in a hurried hand, rain-stained. It counts the powder kegs at the winter camp. The elder in the test room collects them."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/quest/sich_letter_3.tres
msgid "Sich letter (3 of 3)"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/quest/sich_letter_3.tres
msgid "A letter folded small and sewn into cloth. It warns of riders crossing the steppe. The elder in the test room collects them."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/relics/owl_feather.tres
msgid "Owl feather"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/relics/owl_feather.tres
msgid "Long falls land as softly as short ones while it is worn: no hard landing."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/relics/owl_feather.tres
msgid "Owls drop on their prey without a sound. The old women sew a feather into the hats of boys who climb too high, and say it is for luck."
msgstr ""

#. TRANSLATORS: title
#: actors/player/items/relics/seer_lantern.tres
msgid "Seer's lantern"
msgstr ""

#. TRANSLATORS: description
#: actors/player/items/relics/seer_lantern.tres
msgid "Its pale light shows platforms no one else can see while it is worn."
msgstr ""

#. TRANSLATORS: lore
#: actors/player/items/relics/seer_lantern.tres
msgid "A blind seer carried it through the old ruins and never stumbled. Those who borrow it see what she saw: paths that were always there."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/charged/charged_1.tres
msgid "Charged slash"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/charged/charged_1.tres
msgid "Keep holding attack after a ground slash to charge, then let go for a heavy slash."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/charged/charged_2.tres
msgid "Swift charge"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/charged/charged_2.tres
msgid "The charged slash charges twice as fast."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/charged/charged_3.tres
msgid "Charged wave"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/charged/charged_3.tres
msgid "The charged slash also sends a wave along the ground."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/combo/combo_1.tres
msgid "Finishing blow"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/combo/combo_1.tres
msgid "Press attack after the heavy combo swing to end the combo with a forward finisher."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/combo/combo_2.tres
msgid "Rising blow"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/combo/combo_2.tres
msgid "Hold up when pressing attack after the heavy combo swing to leap into a rising finisher."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/combo/combo_3.tres
msgid "Crushing blow"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/combo/combo_3.tres
msgid "Hold down when pressing attack after the heavy combo swing to slam the ground on both sides."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/dive/dive_1.tres
msgid "Dive strike"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/dive/dive_1.tres
msgid "In the air, hold down and attack to dive into the ground and hit everything you land on."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/dive/dive_2.tres
msgid "Wide dive"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/dive/dive_2.tres
msgid "The dive's landing hits a wider area."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/dive/dive_3.tres
msgid "Shockwave dive"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/dive/dive_3.tres
msgid "Diving from high up ends in a huge shockwave."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/lunge/lunge_1.tres
msgid "Lunge"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/lunge/lunge_1.tres
msgid "Press attack during a dash to lunge forward through enemies with a piercing thrust."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/lunge/lunge_2.tres
msgid "Long lunge"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/lunge/lunge_2.tres
msgid "The lunge goes faster and further."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/lunge/lunge_3.tres
msgid "Piercing lunge"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/lunge/lunge_3.tres
msgid "The lunge goes further still and hits much harder."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/ranged/ranged_1.tres
msgid "Spirit bolt"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/ranged/ranged_1.tres
msgid "Press ranged to throw a bolt of spirit. Costs spirit."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/ranged/ranged_2.tres
msgid "Returning bolt"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/ranged/ranged_2.tres
msgid "The bolt flies back to you, hitting again on the way."
msgstr ""

#. TRANSLATORS: title
#: actors/player/skills/ranged/ranged_3.tres
msgid "Bursting bolt"
msgstr ""

#. TRANSLATORS: description
#: actors/player/skills/ranged/ranged_3.tres
msgid "The bolt bursts where it turns around."
msgstr ""

