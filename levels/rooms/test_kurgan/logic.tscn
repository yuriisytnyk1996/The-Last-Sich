[sub_resource type="RectangleShape2D" id="ambush_shape"]
size = Vector2(32, 96)

[sub_resource type="RectangleShape2D" id="idol_shape"]
size = Vector2(56, 40)

[sub_resource type="Resource" id="a_walk"]
script = ExtResource("walk")
to = NodePath("../CutsceneMarks/ArrivalStop")
facing = 1

[sub_resource type="Resource" id="a_title"]
script = ExtResource("title")
title = "The Old Kurgan"
subtitle = "Graves of the steppe"
hold = 2.0

[sub_resource type="Resource" id="a_cam_keeper"]
script = ExtResource("camera")
to = NodePath("../CutsceneMarks/KeeperView")
duration = 1.4

[sub_resource type="Resource" id="a_talk"]
script = ExtResource("dialogue")
dialogue = ExtResource("d_arrival")
speaker = "Grave keeper"

[sub_resource type="Resource" id="a_cam_idol"]
script = ExtResource("camera")
to = NodePath("../CutsceneMarks/IdolView")
duration = 2.0

[sub_resource type="Resource" id="a_wake_outcome"]
script = ExtResource("outcome")
set_flags = Array[StringName]([&"kurgan_idol_woken"])

[sub_resource type="Resource" id="a_wake"]
script = ExtResource("story")
outcome = SubResource("a_wake_outcome")

[sub_resource type="Resource" id="a_shake"]
script = ExtResource("shake")
trauma = 0.35

[sub_resource type="Resource" id="a_wait"]
script = ExtResource("wait")
seconds = 1.0

[sub_resource type="Resource" id="a_warn"]
script = ExtResource("dialogue")
dialogue = ExtResource("d_warning")
speaker = "Grave keeper"

[sub_resource type="Resource" id="a_cam_back"]
script = ExtResource("camera")
duration = 1.2

[sub_resource type="Resource" id="b_face"]
script = ExtResource("walk")
facing = 1

[sub_resource type="Resource" id="b_cam_gate"]
script = ExtResource("camera")
to = NodePath("../CutsceneMarks/GateView")
duration = 0.8

[sub_resource type="Resource" id="b_shout"]
script = ExtResource("dialogue")
dialogue = ExtResource("d_shout")

[sub_resource type="Resource" id="b_open"]
script = ExtResource("call")
node = NodePath("../Gate")
method = &"set_open"
arguments = [true]

[sub_resource type="Resource" id="b_wait"]
script = ExtResource("wait")
seconds = 1.2

[sub_resource type="Resource" id="b_cam_back"]
script = ExtResource("camera")
duration = 0.6

[sub_resource type="Resource" id="c_walk"]
script = ExtResource("walk")
to = NodePath("../CutsceneMarks/IdolStand")
facing = 1

[sub_resource type="Resource" id="c_keeper"]
script = ExtResource("move")
wait = false
node = NodePath("../KeeperRoad")
to = NodePath("../CutsceneMarks/KeeperMound")
duration = 3.0

[sub_resource type="Resource" id="c_cam_idol"]
script = ExtResource("camera")
to = NodePath("../CutsceneMarks/IdolView")
duration = 1.0

[sub_resource type="Resource" id="c_wait"]
script = ExtResource("wait")
seconds = 0.8

[sub_resource type="Resource" id="c_fade_out"]
script = ExtResource("fade")
duration = 1.2

[sub_resource type="Resource" id="c_quote"]
script = ExtResource("quote")
text = "A Cossack's oath is kept by the steppe long after the living forget it."
author = "Words cut into the kurgan stone"
hold = 3.0

[sub_resource type="Resource" id="c_reward_outcome"]
script = ExtResource("outcome")
reward = 250
message = "The kurgan remembers you"

[sub_resource type="Resource" id="c_reward"]
script = ExtResource("story")
outcome = SubResource("c_reward_outcome")

[sub_resource type="Resource" id="c_fade_in"]
script = ExtResource("fade")
to_black = false
duration = 1.2

[sub_resource type="Resource" id="c_cam_keeper"]
script = ExtResource("camera")
to = NodePath("../CutsceneMarks/MoundView")
duration = 1.0

[sub_resource type="Resource" id="c_talk"]
script = ExtResource("dialogue")
dialogue = ExtResource("d_vigil")
speaker = "Grave keeper"

[sub_resource type="Resource" id="keeper_road_here"]
script = ExtResource("condition")
no_flags = Array[StringName]([&"kurgan_vigil_done"])

[sub_resource type="Resource" id="keeper_mound_here"]
script = ExtResource("condition")
all_flags = Array[StringName]([&"kurgan_vigil_done"])

[sub_resource type="Resource" id="idol_woken"]
script = ExtResource("condition")
all_flags = Array[StringName]([&"kurgan_idol_woken"])

[sub_resource type="Resource" id="ambushed"]
script = ExtResource("condition")
all_flags = Array[StringName]([&"kurgan_ambush_seen"])

