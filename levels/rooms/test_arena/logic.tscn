[gd_scene format=4]

[ext_resource type="PackedScene" path="res://levels/objects/door.tscn" id="1_door"]
[ext_resource type="PackedScene" path="res://levels/objects/rest_point.tscn" id="2_rest"]
[ext_resource type="PackedScene" path="res://levels/objects/boss_arena.tscn" id="3_arena"]
[ext_resource type="PackedScene" path="res://levels/objects/mechanisms/gate.tscn" id="4_gate"]
[ext_resource type="PackedScene" path="res://actors/bosses/otaman/otaman.tscn" id="5_otaman"]
[ext_resource type="Script" path="res://components/story/story_trigger.gd" id="story_trigger"]
[ext_resource type="Script" path="res://components/story/story_condition.gd" id="story_condition"]
[ext_resource type="Script" path="res://components/cutscene/cutscene.gd" id="cutscene"]
[ext_resource type="Script" path="res://components/cutscene/cutscene_step.gd" id="step"]
[ext_resource type="Script" path="res://components/cutscene/steps/camera_step.gd" id="camera_step"]
[ext_resource type="Script" path="res://components/cutscene/steps/shake_step.gd" id="shake_step"]
[ext_resource type="Script" path="res://components/cutscene/steps/title_step.gd" id="title_step"]
[ext_resource type="Script" path="res://components/cutscene/steps/wait_step.gd" id="wait_step"]

[sub_resource type="RectangleShape2D" id="trigger_shape"]
size = Vector2(720, 288)

[sub_resource type="Resource" id="kobzar_not_done"]
script = ExtResource("story_condition")
no_flags = Array[StringName]([&"kobzar_done"])

[sub_resource type="Resource" id="intro_camera"]
script = ExtResource("camera_step")
to = NodePath("BossView")
duration = 1.2

[sub_resource type="Resource" id="intro_shake"]
script = ExtResource("shake_step")
trauma = 0.45

[sub_resource type="Resource" id="intro_title"]
script = ExtResource("title_step")
title = "Otaman"
subtitle = "Master of the burned Sich"
hold = 1.6

[sub_resource type="Resource" id="intro_wait"]
script = ExtResource("wait_step")
seconds = 0.3

[sub_resource type="Resource" id="intro_back"]
script = ExtResource("camera_step")
duration = 0.8

[node name="Logic" type="Node2D"]

[node name="SpawnPoint" type="Marker2D" parent="."]
position = Vector2(40, 320)

[node name="Exits" type="Node2D" parent="."]

[node name="Door" parent="Exits" instance=ExtResource("1_door")]
position = Vector2(40, 320)
target_room = "res://levels/rooms/test_barracks.tscn"
target_exit = &"ArenaDoor"
arrival_facing = 1

[node name="RestPoint" parent="." instance=ExtResource("2_rest")]
position = Vector2(104, 320)

[node name="Enemies" type="Node2D" parent="."]

[node name="Otaman" parent="Enemies" instance=ExtResource("5_otaman")]
position = Vector2(720, 320)

[node name="Intro" type="Node2D" parent="."]
script = ExtResource("cutscene")
steps = Array[ExtResource("step")]([SubResource("intro_camera"), SubResource("intro_shake"), SubResource("intro_title"), SubResource("intro_wait"), SubResource("intro_back")])
flag = &"otaman_intro_seen"

[node name="BossView" type="Marker2D" parent="Intro"]
position = Vector2(720, 260)

[node name="BossArena" parent="." node_paths=PackedStringArray("boss", "intro") instance=ExtResource("3_arena")]
boss = NodePath("../Enemies/Otaman")
intro = NodePath("../Intro")

[node name="Shape" type="CollisionShape2D" parent="BossArena/Trigger"]
position = Vector2(576, 176)
shape = SubResource("trigger_shape")

[node name="Gate" parent="BossArena/Gates" instance=ExtResource("4_gate")]
position = Vector2(160, 320)
open = true

[node name="OtamanBeaten" type="Node" parent="BossArena"]
script = ExtResource("story_trigger")
signal_name = &"boss_beaten"
flag = &"otaman_beaten"

[node name="KobzarLeaves" type="Node" parent="BossArena"]
script = ExtResource("story_trigger")
signal_name = &"boss_beaten"
flag = &"kobzar_gone"
condition = SubResource("kobzar_not_done")
