death_penalty = NodePath("../DeathPenalty")
catalog = ExtResource("10_catalog")

[node name="PlayClock" type="Node" parent="."]
script = ExtResource("11_clock")

[node name="TipLog" type="Node" parent="." node_paths=PackedStringArray("inventory")]
script = ExtResource("tip_log")
all = Array[ExtResource("tip_script")]([ExtResource("tip_healing"), ExtResource("tip_parry"), ExtResource("tip_execution"), ExtResource("tip_death_mark"), ExtResource("tip_death_marks_more"), ExtResource("tip_charms"), ExtResource("tip_blades"), ExtResource("tip_relics"), ExtResource("tip_dumas"), ExtResource("tip_captives")])
first_death_tip = ExtResource("tip_death_mark")
second_death_tip = ExtResource("tip_death_marks_more")
charm_tip = ExtResource("tip_charms")
blade_tip = ExtResource("tip_blades")
relic_tip = ExtResource("tip_relics")
duma_tip = ExtResource("tip_dumas")
inventory = NodePath("../Player/Inventory")

