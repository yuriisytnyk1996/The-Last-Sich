[gd_resource type="Resource" script_class="Tip" format=3]

[ext_resource type="Script" path="res://components/tips/tip.gd" id="1_tip"]

[resource]
script = ExtResource("1_tip")
id = &"blades"
title = "Blades"
text = "You found a new blade. Open the inventory with {inventory} to take it up.

You carry one blade at a time. Wearing another puts the old one away."
