[gd_resource type="Resource" script_class="Tip" format=3]

[ext_resource type="Script" path="res://components/tips/tip.gd" id="1_tip"]

[resource]
script = ExtResource("1_tip")
id = &"relics"
title = "Relics"
text = "You found a relic. Relics are old tools that change how you get around.

Open the inventory with {inventory} and wear it in a relic slot to use it."
