[gd_resource type="Resource" script_class="Tip" format=3]

[ext_resource type="Script" path="res://components/tips/tip.gd" id="1_tip"]

[resource]
script = ExtResource("1_tip")
id = &"death_marks_more"
title = "Clearing marks"
text = "Marks add up, and each one weakens you more. Up to five can wait for you at once.

A cleanse point clears every mark at once, for a price."
