[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://components/story/dialogue.gd" id="r1"]
[ext_resource type="Script" path="res://components/story/story_outcome.gd" id="r2"]
[ext_resource type="Script" path="res://components/story/dialogue_choice.gd" id="r3"]

[sub_resource type="Resource" id="outcome_1"]
script = ExtResource("r2")
cost = 200
counter = &"alms_given"
counter_add = 200
message = "Given to the church: 200"

[sub_resource type="Resource" id="choice_2"]
script = ExtResource("r3")
text = "Give 200"
outcome = SubResource("outcome_1")

[sub_resource type="Resource" id="outcome_3"]
script = ExtResource("r2")
cost = 500
counter = &"alms_given"
counter_add = 500
message = "Given to the church: 500"

[sub_resource type="Resource" id="choice_4"]
script = ExtResource("r3")
text = "Give 500"
outcome = SubResource("outcome_3")

[sub_resource type="Resource" id="choice_5"]
script = ExtResource("r3")
text = "Leave"

[resource]
script = ExtResource("r1")
lines = PackedStringArray("An iron box for the church, chained to the wall. Coins rattle somewhere deep inside.")
choices = Array[ExtResource("r3")]([SubResource("choice_2"), SubResource("choice_4"), SubResource("choice_5")])
